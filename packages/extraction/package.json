{
  "name": "@minecraft-api/extraction",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "prebuild": "tsx scripts/fetch-manifest.ts",
    "build": "tsup",
    "dev": "tsup --watch",
    "extract": "tsx src/cli.ts",
    "lint": "biome lint .",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^24.10.1",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.2"
  }
}
