{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "deploy": "pylon build && wrangler deploy",
    "dev": "pylon dev -c \"wrangler dev\"",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui --coverage",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "@getcronit/pylon": "^2.9.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@cloudflare/vitest-pool-workers": "^0.10.11",
    "@cloudflare/workers-types": "^4.20251127.0",
    "@getcronit/pylon-dev": "^1.0.6",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/ui": "4.0.14",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "wrangler": "^4.51.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/getcronit/pylon.git"
  },
  "homepage": "https://pylon.cronit.io"
}
